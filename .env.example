# ========================================================
# GANG.SOUL Production Environment Configurations
# ========================================================

# 1. 基础服务网络配置
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
GATEWAY_URL=http://127.0.0.1:3000

# 2. Solana 链上与 RPC 节点配置
SOLANA_NETWORK=devnet
SOLANA_DEVNET_RPC=https://api.devnet.solana.com
SOLANA_DEVNET_WS=wss://api.devnet.solana.com
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_WS=wss://api.mainnet-beta.solana.com

# 3. Jito MEV 引擎配置 (防抢跑与 Tip 捆绑)
JITO_BLOCK_ENGINE_URL=https://devnet.block-engine.jito.wtf
JITO_TIP_SOL=0.001

# 4. Agent 主助记词 (派生 10 个 M2M 子钱包集群)
# 生产环境请替换为 Squads v4 或强随机安全助记词，严禁明文泄露
AGENT_MNEMONIC=wool vintage lock whisper razor diesel divide plastic unaware shield shock brass abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon art

# 5. 核心合约与 DID 协议配置
GANG_PROGRAM_ID=GangLaunchpad111111111111111111111111111111
GANG_PASSPORT_PROGRAM_ID=GangPassport1111111111111111111111111111111
SOUL_REGISTRY_DOMAIN=soul

# 6. 量化做市集群策略参数
TARGET_MINT=GangSoulAlphaLiveMint111111111111111111111
QUANT_CYCLE_INTERVAL_MS=3000
MAX_BUY_TRANCHE_SOL=1.5
HOLDING_CAP_TOKENS=10000000

# 7. 协议收益地址（EVM侧 Arc L1 / Solana侧 均指向同一控制人）
# EVM 侧：ArcNameRegistrar beneficiary，USDC 结算直接转入该地址
# Solana 侧：fee_receiver 通过 GlobalConfig PDA 在链上公开存储，受 Squads v4 保护
GANG_PROTOCOL_FEE_RECEIVER_EVM=0x10687368eF1be3f178de0fCCf5EdfF49e1C258B1
# Solana 侧收益钱包（由 BIP-44 m/44'/501'/99'/0' 派生的专用收益子钱包，部署后写入 GlobalConfig PDA）
GANG_PROTOCOL_FEE_RECEIVER_SOLANA=
# 协议创建费（每次发行新代币向 fee_receiver 转入，单位 SOL）
GANG_LAUNCH_FEE_SOL=0.02
# 协议交易分成（Bonding Curve 买卖手续费中归 fee_receiver 的比例，bps）
GANG_PROTOCOL_FEE_BPS=20

# 8. x402 链上微支付网关配置
X402_PAYMENT_WALLET=5mockTreasurySolanaWalletAddress111111111111111
ALPHA_SIGNAL_FEE_SOL=0.005

# 9. 毕业门槛档位配置（三档可选，默认 STANDARD）
# MICRO=30 SOL  社区 Meme 快速毕业
# STANDARD=50 SOL  默认推荐，约 $10,000 USD
# WHALE=85 SOL   对齐 gang.fun / pump.fun
GRADUATION_TIER=STANDARD
GRADUATION_TARGET_SOL=50

# 10. AFC .soul 双链 DID 桥接配置
# Arc L1 合约地址（testnet 已部署，mainnet 切换时更新）
AFC_CHAIN_ID=5042002
AFC_RPC_URL=https://rpc.testnet.arc.io
AFC_REGISTRY_ADDRESS=0x79f1DF663a4b543cEF6bB09e7A47C050eC0A7398
AFC_RESOLVER_ADDRESS=0xF1A286D1374969d24601C46D117DBA4Bc59b35cD
AFC_REGISTRAR_ADDRESS=0xaC3fa556996c8865e61f995f83E8e1ea56a28c0b
# Arc L1 读取节点（无需私钥，只读调用 eth_call）
AFC_READ_ONLY=true
